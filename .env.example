# Values are literal (systemd EnvironmentFile); the caller's environment wins.
# See: https://github.com/webitel/crypto

# Database connection (libpq).
#PGHOST=127.0.0.1
#PGPORT=5432
#PGUSER=webitel
#PGPASSWORD=
#PGDATABASE=webitel
#PGSSLMODE=prefer

# Directory with the .cipher / .search key files.
#CRYPTO_DIR=/var/lib/webitel/crypto

# Encryption keyring (the services' keys): inline keys or a key file; _KEYFILE wins.
#CRYPTO_CIPHER_KEYRING=
#CRYPTO_CIPHER_KEYFILE=/var/lib/webitel/crypto/.cipher

# Search (blind index) keyring: required, the Webitel schemas have searchable fields.
#CRYPTO_SEARCH_KEYRING=
#CRYPTO_SEARCH_KEYFILE=/var/lib/webitel/crypto/.search

# Key file permission check: strict or unsafe (warn only, same as --unsafe-keys).
#CRYPTO_KEYFILE_POLICY=strict

# Packaged store and schema directories.
#CRYPTO_STORE_DIR=/usr/share/webitel/crypto/store.d
#CRYPTO_SCHEMA_DIR=/usr/share/webitel/crypto/schema.d
