# webitel-cryptoctl settings. A variable set in the caller's environment wins over this file.
# Read like a systemd EnvironmentFile: KEY=value, values taken literally (no shell expansion),
# so a keyring line can be copied from a service's /etc/default file as is.
# For more crypto environment variables see: https://github.com/webitel/crypto (cryptobox, cryptostore)

# Database connection (libpq environment), see: https://www.postgresql.org/docs/current/libpq-envars.html
#PGHOST=127.0.0.1
#PGPORT=5432
#PGUSER=webitel
#PGPASSWORD=
#PGDATABASE=webitel
#PGSSLMODE=prefer

# Directory with the well-known key files (.cipher, .search) used when no keyring variable is set.
# Default in Webitel builds: /var/lib/webitel/crypto.
#CRYPTO_DIR=/var/lib/webitel/crypto

# Value-encryption keyring: the services' keys. Set only one of _KEYRING (inline keys, separated by
# a newline or a comma) or _KEYFILE (a path); _KEYFILE wins when both are set.
#CRYPTO_CIPHER_KEYRING=
#CRYPTO_CIPHER_KEYFILE=/var/lib/webitel/crypto/.cipher

# Blind-index (exact-match search) keyring: required, the Webitel schemas have searchable fields.
#CRYPTO_SEARCH_KEYRING=
#CRYPTO_SEARCH_KEYFILE=/var/lib/webitel/crypto/.search

# Key file permission check: strict (default) rejects key files readable beyond owner/group;
# unsafe logs a warning and loads them anyway (same as --unsafe-keys).
#CRYPTO_KEYFILE_POLICY=strict

# Packaged store and schema directories; override only to run against other files.
#CRYPTO_STORE_DIR=/usr/share/webitel/crypto/store.d
#CRYPTO_SCHEMA_DIR=/usr/share/webitel/crypto/schema.d
