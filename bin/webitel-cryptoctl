#!/bin/sh
# Runs cryptoctl (Webitel schemas compiled in) on the packaged store. /etc/default/webitel-cryptoctl is read
# like a systemd EnvironmentFile (literal values); the caller's environment wins.
set -eu

envfile=/etc/default/webitel-cryptoctl
if [ -r "$envfile" ]; then
	fromfile=" "
	while IFS= read -r line || [ -n "$line" ]; do
		case $line in
		[A-Za-z_]*=*) name=${line%%=*} ;;
		*) continue ;;
		esac
		case $name in *[!A-Za-z0-9_]*) continue ;; esac
		case $fromfile in
		*" $name "*) ;; # repeated: the last value wins
		*)
			eval "[ -n \"\${$name+set}\" ]" && continue # set by the caller
			fromfile="$fromfile$name "
			;;
		esac
		value=${line#*=}
		case $value in
		\"*\") value=${value#\"} value=${value%\"} ;;
		\'*\') value=${value#\'} value=${value%\'} ;;
		esac
		export "$name=$value"
	done <"$envfile"
fi

: "${CRYPTO_STORE_DIR:=/usr/share/webitel/crypto/store.d}"
export CRYPTO_STORE_DIR

exec /usr/local/bin/cryptoctl "$@"
