{
  "version": 1,
  "units": {
    "chat.bot": {
      "fields": {
        "metadata": {
          "nested": [
            // custom
            { "path": ["secret"] },
            // viber
            // telegram
            { "path": ["token"] },
            // infobip_whatsapp
            { "path": ["api_key"] },
            // gotd
            { "path": ["api_hash"] },
            // gotd: backup data
            { "path": [".auth"] },
            { "path": [".gotd"] },
            // messenger
            { "path": ["client_secret"] },
            { "path": ["whatsapp_token"] },
            // messenger: backup data
            { "path": ["fb"] },
            { "path": ["ig"] },
            { "path": ["wa"] }
          ]
        }
      }
    }
  }
}
