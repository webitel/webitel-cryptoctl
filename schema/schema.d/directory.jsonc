{
  "version": 1,
  "units": {
    "directory.wbt_oauth_service": {
      "fields": {
        "client_secret": {}
      }
    },
    "directory.wbt_user_token": {
      "fields": {
        "token": { "search": true }
      }
    },
    "directory.wbt_session": {
      "fields": {
        "code": { "search": true },
        "access": { "search": true },
        "refresh": { "search": true },
        "props": {
          "nested": [
            { "path": ["csrf"] },                // Cookie
            { "path": ["pn-rpid"] },             // SSE PUSH
            { "path": ["oauth.id_token"] },      // SSO Creds
            { "path": ["oauth.access_token"] },  // SSO Creds
            { "path": ["oauth.refresh_token"] }  // SSO Creds
          ]
        }
      }
    },
    "directory.wbt_ldap": {
      "fields": {
        "password": {}
      }
    },
    "directory.wbt_totp": {
      "fields": {
        "key": {}
      }
    }
  }
}
